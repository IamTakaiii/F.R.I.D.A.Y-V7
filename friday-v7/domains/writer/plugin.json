{
  "id": "domain.writer",
  "version": "0.1.0",
  "display_name": "Writer",
  "description": "Clear shareable documents. Headings English. Types live in `schema/` — no writer-owned release-notes twin.",
  "surfaces": [
    "/fr-write"
  ],
  "provides": [
    "mode.note",
    "mode.brief",
    "mode.spec",
    "mode.present",
    "mode.polish",
    "mode.release_notes"
  ],
  "hooks": {
    "on_pack_enter": true,
    "on_session_end": true
  },
  "entry": "SKILL.md"
}
